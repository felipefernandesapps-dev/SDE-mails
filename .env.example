# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_dispatcher?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# App
PORT=3001
NODE_ENV=development

# Encryption (must be 32 characters for AES-256)
ENCRYPTION_KEY=change-this-to-a-secure-32-char-key

# Admin (for initial dev only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# For Gmail SMTP (use app password in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_APP_PASSWORD=your_app_password
